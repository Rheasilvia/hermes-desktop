{
  "name": "@hermes/studio",
  "productName": "Hermes Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "dev:electron": "npm run build:electron -- --dev && wait-on http://127.0.0.1:1420 && cross-env HERMES_STUDIO_DEV_SERVER=http://127.0.0.1:1420 electron .",
    "backend": "DESKTOP_BACKEND_PORT=18080 DESKTOP_BACKEND_TOKEN=dev-secret uv run --directory sidecar python -m daemon",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/bundle-electron.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run backend:build && npm run build && electron-builder --dir",
    "dist": "npm run backend:build && npm run build && electron-builder",
    "tauri": "tauri",
    "backend:build": "uv run --directory sidecar python scripts/build_dist.py",
    "tauri:dev": "npm run backend:build && tauri dev",
    "tauri:build": "tauri build",
    "type-check": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src/ electron/",
    "lint:css-tokens": "bash scripts/check-css-tokens.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@shikijs/engine-javascript": "^4.2.0",
    "@solidjs/router": "^0.16.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.8",
    "katex": "^0.16.47",
    "lucide-solid": "^1.17.0",
    "marked": "^18.0.5",
    "node-pty": "1.1.0",
    "shiki": "^4.2.0",
    "solid-js": "^1.9.13",
    "unicode-animations": "^1.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.9.2",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "40.10.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.hermes-agent.studio",
    "productName": "Hermes Studio",
    "executableName": "Hermes Studio",
    "artifactName": "Hermes-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "public/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "sidecar/dist/electron",
        "to": "sidecar",
        "filter": [
          "daemon",
          "daemon.exe"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
