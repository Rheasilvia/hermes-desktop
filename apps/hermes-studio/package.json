{
  "name": "@hermes/studio",
  "productName": "Hermes Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "dev:electron": "npm run build:electron -- --dev && wait-on http://127.0.0.1:1420 && cross-env HERMES_STUDIO_DEV_SERVER=http://127.0.0.1:1420 electron .",
    "backend": "cross-env DESKTOP_BACKEND_PORT=18080 DESKTOP_BACKEND_TOKEN=dev-secret uv run --directory sidecar python -m daemon",
    "build": "npm run build:renderer && npm run build:electron && npm run build:native",
    "build:renderer": "vite build",
    "build:electron": "node scripts/bundle-electron.mjs",
    "build:native": "node scripts/stage-native-deps.mjs",
    "start": "npm run build && electron .",
    "builder": "electron-builder",
    "pack": "npm run backend:build && npm run build && npm run builder -- --dir",
    "dist": "npm run backend:build && npm run build && npm run builder",
    "dist:mac": "npm run backend:build && npm run build && npm run builder -- --mac dmg",
    "dist:win": "npm run backend:build && npm run build && npm run builder -- --win nsis",
    "dist:linux": "npm run backend:build && npm run build && npm run builder -- --linux AppImage deb rpm",
    "backend:build": "uv run --directory sidecar python scripts/build_dist.py",
    "type-check": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src/ electron/",
    "lint:css-tokens": "bash scripts/check-css-tokens.sh",
    "test": "vitest run && npm run test:packaging",
    "test:packaging": "node --test scripts/stage-native-deps.test.mjs scripts/before-pack.test.mjs scripts/signing.test.mjs scripts/packaged-smoke.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:packaged": "npm run pack && npm run test:packaged:existing",
    "test:packaged:existing": "node scripts/packaged-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run docs:check"
  },
  "dependencies": {
    "@shikijs/engine-javascript": "^4.2.0",
    "@solidjs/router": "^0.16.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.8",
    "katex": "^0.16.47",
    "lucide-solid": "^1.17.0",
    "marked": "^18.0.5",
    "node-pty": "1.1.0",
    "shiki": "^4.2.0",
    "solid-js": "^1.9.13",
    "unicode-animations": "^1.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.9.2",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "40.10.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.5"
  },
  "build": {
    "electronVersion": "40.10.2",
    "appId": "com.hermes-agent.studio",
    "productName": "Hermes Studio",
    "executableName": "Hermes Studio",
    "artifactName": "Hermes-Studio-${version}-${os}-${arch}.${ext}",
    "icon": "build/assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "public/**",
      "package.json"
    ],
    "beforeBuild": "scripts/before-build.mjs",
    "beforePack": "scripts/before-pack.mjs",
    "afterPack": "scripts/after-pack.mjs",
    "afterSign": "scripts/after-sign.mjs",
    "asar": true,
    "asarUnpack": [
      "dist/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "sidecar/dist/electron",
        "to": "sidecar",
        "filter": [
          "daemon",
          "daemon.exe"
        ]
      }
    ],
    "mac": {
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hermes Studio uses the microphone only when you start a voice interaction."
      },
      "hardenedRuntime": true,
      "binaries": [
        "Contents/Resources/sidecar/daemon"
      ],
      "target": [
        "dmg"
      ]
    },
    "win": {
      "signExts": [
        ".exe"
      ],
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "Nous Research <support@nousresearch.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Hermes Studio",
      "uninstallDisplayName": "Hermes Studio"
    }
  }
}
